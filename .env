ASPNETCORE_ENVIRONMENT=Development
GUARDIAO_LOG_LEVEL=Information
GUARDIAO_TIMEZONE=America/Sao_Paulo

DB_HOST=postgres
DB_PORT=5432
DB_NAME=guardiao_db
DB_USER=guardiao_user
DB_PASSWORD=change-me-db

REDIS_ENABLED=true
REDIS_CONNECTION_STRING=redis:6379

OBJECT_STORAGE_ROOT_PATH=/var/lib/guardiao/object-storage
OBJECT_STORAGE_BUCKET=guardiao-evidence
OBJECT_STORAGE_MAX_OBJECT_SIZE_BYTES=5242880

VICTIM_REGISTRY_BASE_URL=https://victim-registry.example.com
VICTIM_REGISTRY_TOKEN_URL=https://victim-registry.example.com/oauth/token
VICTIM_REGISTRY_CLIENT_ID=guardiao-api
VICTIM_REGISTRY_CLIENT_SECRET=change-me-client-secret
VICTIM_REGISTRY_SCOPE=cases.read media.read
VICTIM_REGISTRY_WEBHOOK_SECRET=change-me-webhook-secret
VICTIM_REGISTRY_ALLOWED_CLOCK_SKEW_SECONDS=300
VICTIM_REGISTRY_RECONCILIATION_INTERVAL_SECONDS=300
VICTIM_REGISTRY_RECONCILIATION_PAGE_SIZE=100
VICTIM_REGISTRY_INITIAL_LOOKBACK_MINUTES=60

API_ENABLE_DEBUG_HEADER_AUTHENTICATION=false
API_ENABLE_SWAGGER_UI=false
API_MAX_REQUEST_BODY_BYTES=65536
API_MAX_WEBHOOK_REQUEST_BODY_BYTES=16384
API_WRITE_RATE_LIMIT_PERMIT_LIMIT=60
API_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
API_WEBHOOK_RATE_LIMIT_PERMIT_LIMIT=30
API_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

WEB_ENABLE_OPERATIONS_DEMO_LOGIN=true

EDGE_HEALTH_PORT=18081
EDGE_QUEUE_SIZE_PER_CAMERA=2
EDGE_INGRESS_TARGET_FPS=15
EDGE_PROCESSING_TARGET_FPS=4
EDGE_MATCH_THRESHOLD=0.82
EDGE_MINIMUM_DETECTION_SCORE=0.2
EDGE_RECONNECT_DELAY_MS=250
