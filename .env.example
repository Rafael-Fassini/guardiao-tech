ASPNETCORE_ENVIRONMENT=Production
GUARDIAO_LOG_LEVEL=Information
GUARDIAO_TIMEZONE=America/Sao_Paulo

DB_HOST=postgres
DB_PORT=5432
DB_NAME=guardiao_db
DB_USER=guardiao_user
DB_PASSWORD=change-me-db

REDIS_ENABLED=true
REDIS_CONNECTION_STRING=redis:6379

OBJECT_STORAGE_ROOT_PATH=/var/lib/guardiao/object-storage
OBJECT_STORAGE_BUCKET=guardiao-evidence
OBJECT_STORAGE_MAX_OBJECT_SIZE_BYTES=5242880

VICTIM_REGISTRY_BASE_URL=https://victim-registry.example.com
VICTIM_REGISTRY_TOKEN_URL=https://victim-registry.example.com/oauth/token
VICTIM_REGISTRY_CLIENT_ID=guardiao-api
VICTIM_REGISTRY_CLIENT_SECRET=change-me-client-secret
VICTIM_REGISTRY_SCOPE=cases.read media.read
VICTIM_REGISTRY_WEBHOOK_SECRET=change-me-webhook-secret
VICTIM_REGISTRY_ALLOWED_CLOCK_SKEW_SECONDS=300
VICTIM_REGISTRY_RECONCILIATION_INTERVAL_SECONDS=300
VICTIM_REGISTRY_RECONCILIATION_PAGE_SIZE=100
VICTIM_REGISTRY_INITIAL_LOOKBACK_MINUTES=60

API_ENABLE_DEBUG_HEADER_AUTHENTICATION=false
API_ENABLE_SWAGGER_UI=false
PANEL_API_BASE_URL=http://api:8080
PANEL_API_SHARED_SECRET=change-me-panel-secret
WORKER_API_BASE_URL=http://api:8080
WORKER_API_SHARED_SECRET=change-me-worker-secret
WORKER_PREVIEW_BASE_URL=http://worker:18081
CORRELATION_COPRESENCE_WINDOW_MINUTES=5
CORRELATION_DUPLICATE_SUPPRESSION_WINDOW_SECONDS=30
CORRELATION_REQUIRE_SAME_SITE=true
WORKER_ID=edge-worker-01
NOTIFY_ENABLE_WEBHOOK=false
NOTIFY_WEBHOOK_URL=https://notifications.example.test/guardiao/incidents
NOTIFY_WEBHOOK_SECRET=change-me-notify-webhook-secret
NOTIFY_ENABLE_SMTP=false
NOTIFY_SMTP_HOST=mailhog
NOTIFY_SMTP_PORT=1025
NOTIFY_SMTP_USE_SSL=false
NOTIFY_SMTP_USERNAME=
NOTIFY_SMTP_PASSWORD=
NOTIFY_SMTP_SENDER=guardiao@example.test
NOTIFY_SMTP_RECIPIENT=operator@example.test
NOTIFY_TIMEOUT_SECONDS=5
NOTIFY_RETRY_ATTEMPTS=3
NOTIFY_INITIAL_RETRY_DELAY_MS=250
NOTIFY_ENABLE_ESCALATION=true
NOTIFY_ESCALATION_WINDOW_MINUTES=15
NOTIFY_ESCALATION_SCAN_INTERVAL_SECONDS=60
API_MAX_REQUEST_BODY_BYTES=1048576
API_MAX_WEBHOOK_REQUEST_BODY_BYTES=16384
API_WRITE_RATE_LIMIT_PERMIT_LIMIT=60
API_WRITE_RATE_LIMIT_WINDOW_SECONDS=60
API_WEBHOOK_RATE_LIMIT_PERMIT_LIMIT=30
API_WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60
BIOMETRIC_DETECTION_MODEL_PATH=/app/models/haarcascade_frontalface_default.xml
BIOMETRIC_EMBEDDING_MODEL_PATH=/app/models/face-embedding.onnx

WEB_ENABLE_OPERATIONS_DEMO_LOGIN=false

EDGE_HEALTH_PORT=18081
EDGE_QUEUE_SIZE_PER_CAMERA=2
EDGE_INGRESS_TARGET_FPS=15
EDGE_PROCESSING_TARGET_FPS=4
EDGE_MATCH_THRESHOLD=0.82
EDGE_MINIMUM_DETECTION_SCORE=0.2
EDGE_DETECTION_MODEL_PATH=/app/models/haarcascade_frontalface_default.xml
EDGE_EMBEDDING_MODEL_PATH=/app/models/face-embedding.onnx
EDGE_GALLERY_REFRESH_INTERVAL_SECONDS=30
EDGE_RECONNECT_DELAY_MS=250
EDGE_CAMERA_0_ID=33333333-3333-3333-3333-333333333333
EDGE_CAMERA_0_SITE_ID=22222222-2222-2222-2222-222222222222
EDGE_CAMERA_0_PROTECTED_CASE_ID=44444444-4444-4444-4444-444444444444
EDGE_CAMERA_0_NAME=Camera Piloto
EDGE_CAMERA_0_SOURCE=webcam://0
EDGE_CAMERA_0_DEVICE_PATH=/dev/video0
EDGE_CAMERA_0_ENABLED=true
