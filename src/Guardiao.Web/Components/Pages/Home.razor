@page "/"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Resumo</PageTitle>

<h1>Resumo operacional</h1>

<div class="cards">
    <section class="metric">
        <span>Incidentes</span>
        <strong>@summary?.IncidentCount</strong>
    </section>
    <section class="metric">
        <span>Casos monitorados</span>
        <strong>@summary?.CaseCount</strong>
    </section>
    <section class="metric">
        <span>Cameras</span>
        <strong>@summary?.CameraCount</strong>
    </section>
    <section class="metric">
        <span>Auditoria recente</span>
        <strong>@summary?.AuditEntryCount</strong>
    </section>
</div>

<div class="two-col">
    <section class="panel">
        <h2>Fila de revisao</h2>
        @foreach (var incident in summary?.RecentIncidents ?? [])
        {
            <a class="row-link" href="/incidents/@incident.Id">
                <span>@incident.Id.ToString()[..8]</span>
                <strong>@incident.Status</strong>
            </a>
        }
    </section>

    <section class="panel">
        <h2>Auditoria recente</h2>
        @foreach (var entry in summary?.RecentAuditEntries ?? [])
        {
            <div class="audit-row">
                <strong>@entry.Action</strong>
                <span>@entry.CreatedAtUtc.ToLocalTime()</span>
            </div>
        }
    </section>
</div>

<style>
    .cards {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 14px;
        margin-bottom: 18px;
    }

    .metric, .panel {
        background: rgba(255,250,242,0.88);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 18px;
    }

    .metric span, .audit-row span {
        color: var(--muted);
    }

    .metric strong {
        display: block;
        margin-top: 10px;
        font-size: 2rem;
    }

    .two-col {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .row-link, .audit-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 0;
        border-top: 1px solid rgba(216,203,182,0.6);
        text-decoration: none;
        color: inherit;
    }

    @@media (max-width: 900px) {
        .two-col {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private OperationsSummaryModel? summary;

    protected override async Task OnInitializedAsync()
    {
        summary = await PanelService.GetSummaryAsync();
    }
}
