@page "/"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Resumo</PageTitle>

@if (isLoading)
{
    <p class="panel-empty">Carregando panorama operacional.</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <section class="panel-empty panel-error">
        <strong>Falha ao carregar o resumo operacional.</strong>
        <span>@loadError</span>
    </section>
}
else if (summary is null)
{
    <p class="panel-empty">Nenhum resumo operacional disponivel.</p>
}
else
{
    var activeAlerts = summary.CameraViews.Where(x => x.ActiveAlert is not null).ToList();

    <section class="hero">
        <div>
            <p class="eyebrow">Centro de monitoramento protegido</p>
            <h1>Resumo operacional</h1>
            <p class="hero-copy">
                A tela principal consolida as ultimas evidencias capturadas por camera, as mulheres protegidas vistas no ambiente
                e alertas de co-presenca quando um agressor monitorado aparece no mesmo ponto observado.
            </p>
        </div>
        <div class="hero-pulse @(activeAlerts.Count > 0 ? "hero-pulse-alert" : string.Empty)">
            <span>@(activeAlerts.Count > 0 ? "ALERTA" : "ESTAVEL")</span>
            <strong>@(activeAlerts.Count > 0 ? $"{activeAlerts.Count} camera(s) exigem atencao" : "Nenhum risco simultaneo identificado")</strong>
        </div>
    </section>

    <div class="definition-grid">
        <section class="definition-card">
            <span class="definition-label">Incidente</span>
            <p>Ocorrencia criada pelo backend quando uma deteccao relevante vira evento operacional e segue para revisao humana.</p>
        </section>
        <section class="definition-card">
            <span class="definition-label">Casos monitorados</span>
            <p>Pessoas cadastradas para acompanhamento ativo com biometria, regras de camera e classificacao operacional.</p>
        </section>
    </div>

    <div class="cards">
        <section class="metric metric-hot">
            <span>Incidentes</span>
            <strong>@summary.IncidentCount</strong>
        </section>
        <section class="metric">
            <span>Casos monitorados</span>
            <strong>@summary.CaseCount</strong>
        </section>
        <section class="metric">
            <span>Cameras</span>
            <strong>@summary.CameraCount</strong>
        </section>
        <section class="metric">
            <span>Auditoria recente</span>
            <strong>@summary.AuditEntryCount</strong>
        </section>
    </div>

    @if (activeAlerts.Count > 0)
    {
        <section class="alert-strip">
            @foreach (var camera in activeAlerts)
            {
                <article class="alert-card">
                    <div>
                        <span class="alert-label">Agressor detectado</span>
                        <strong>@camera.ActiveAlert!.FullName em @camera.CameraName</strong>
                    </div>
                    <p>
                        Co-presenca com @string.Join(", ", camera.ActiveAlert.NearbyProtectedWomen) em @camera.SiteName
                        as @camera.ActiveAlert.DetectedAtUtc.ToLocalTime().ToString("HH:mm").
                    </p>
                </article>
            }
        </section>
    }

    @if (summary.CameraViews.Count == 0)
    {
        <section class="panel-empty operational-empty">
            <strong>Nenhuma camera monitorada disponivel.</strong>
            <span>Assim que houver cameras cadastradas com evidencias recentes, o painel operacional exibira a ultima leitura de cada ambiente.</span>
        </section>
    }
    else
    {
        <section class="camera-wall">
            @foreach (var camera in OrderedCameraViews())
            {
                var previewUrl = GetEvidenceUrl(camera.LatestSnapshot);
                <article class="camera-card @(camera.ActiveAlert is not null ? "camera-card-alert" : string.Empty)">
                    <div class="camera-head">
                        <div>
                            <span class="camera-site">@camera.SiteName</span>
                            <h2>@camera.CameraName</h2>
                        </div>
                        <span class="camera-status @(camera.IsEnabled ? "camera-status-live" : "camera-status-off")">
                            @(camera.IsEnabled ? "Monitorando" : "Desabilitada")
                        </span>
                    </div>

                    <div class="camera-preview">
                        @if (!string.IsNullOrWhiteSpace(previewUrl))
                        {
                            <img src="@previewUrl" alt="Ultima evidencia capturada pela camera @camera.CameraName" />
                        }
                        else
                        {
                            <div class="camera-preview-empty">
                                <strong>Nenhuma evidencia visual recente</strong>
                                <span>O painel usa a ultima evidencia disponivel por camera, nao streaming ao vivo.</span>
                            </div>
                        }
                    </div>

                    <div class="camera-meta">
                        <span>Origem: @camera.StreamEndpoint</span>
                        <span>
                            Ultima deteccao:
                            @(camera.LastDetectionAtUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "sem leitura recente")
                        </span>
                    </div>

                    @if (camera.ActiveAlert is not null)
                    {
                        <section class="camera-alert">
                            <div class="camera-alert-head">
                                <strong>Alerta de agressor no ambiente</strong>
                                <span>Score @camera.ActiveAlert.MatchScore.ToString("0.00")</span>
                            </div>
                            <p>
                                @camera.ActiveAlert.FullName foi identificado no mesmo ambiente de
                                @string.Join(", ", camera.ActiveAlert.NearbyProtectedWomen).
                            </p>
                        </section>
                    }

                    <section class="detection-panel">
                        <div class="section-head">
                            <strong>Mulheres detectadas no ambiente</strong>
                            <span>@camera.RecentProtectedWomen.Count item(ns)</span>
                        </div>

                        @if (camera.RecentProtectedWomen.Count == 0)
                        {
                            <p class="panel-empty camera-empty">Nenhuma mulher protegida detectada nesta camera nas ultimas leituras.</p>
                        }
                        else
                        {
                            <div class="detection-list">
                                @foreach (var detection in camera.RecentProtectedWomen)
                                {
                                    var detectionPreviewUrl = GetEvidenceUrl(detection.Snapshot);
                                    <article class="detection-card">
                                        @if (!string.IsNullOrWhiteSpace(detectionPreviewUrl))
                                        {
                                            <img src="@detectionPreviewUrl" alt="Evidencia de @detection.FullName" />
                                        }
                                        <div>
                                            <strong>@detection.FullName</strong>
                                            <span>@DescribeRole(detection.SubjectRole)</span>
                                            <span>
                                                Detectada em @detection.DetectedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")
                                                com score @detection.MatchScore.ToString("0.00")
                                            </span>
                                            <span>Status do incidente: @DescribeIncidentStatus(detection.IncidentStatus)</span>
                                        </div>
                                    </article>
                                }
                            </div>
                        }
                    </section>
                </article>
            }
        </section>
    }

    <div class="two-col">
        <section class="panel">
            <div class="section-head">
                <h2>Fila de revisao</h2>
                <a href="/incidents">Ver tudo</a>
            </div>
            @foreach (var incident in summary.RecentIncidents)
            {
                <a class="row-link" href="/incidents/@incident.Id">
                    <span>@incident.Id.ToString()[..8]</span>
                    <strong>@DescribeIncidentStatus(incident.Status)</strong>
                </a>
            }
        </section>

        <section class="panel">
            <div class="section-head">
                <h2>Auditoria recente</h2>
                <a href="/audit">Abrir trilha</a>
            </div>
            @foreach (var entry in summary.RecentAuditEntries)
            {
                <div class="audit-row">
                    <strong>@entry.Action</strong>
                    <span>@entry.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
            }
        </section>
    </div>
}

<style>
    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1.6fr) minmax(260px, 0.8fr);
        gap: 18px;
        padding: 24px;
        border-radius: 30px;
        background:
            linear-gradient(135deg, rgba(22, 40, 34, 0.96), rgba(52, 84, 68, 0.92)),
            linear-gradient(135deg, rgba(164,81,43,0.24), transparent);
        color: #f5ecde;
        box-shadow: 0 18px 45px rgba(31, 42, 32, 0.18);
        margin-bottom: 18px;
    }

    .eyebrow,
    .definition-label,
    .camera-site,
    .alert-label {
        letter-spacing: 0.12em;
        text-transform: uppercase;
        font-size: 0.75rem;
    }

    .hero h1,
    .camera-card h2 {
        margin: 6px 0 10px;
    }

    .hero-copy {
        max-width: 68ch;
        color: rgba(245, 236, 222, 0.82);
        line-height: 1.6;
        margin-bottom: 0;
    }

    .hero-pulse {
        border: 1px solid rgba(245,236,222,0.16);
        border-radius: 24px;
        padding: 18px;
        background: rgba(255,255,255,0.06);
        display: grid;
        align-content: center;
        gap: 8px;
    }

    .hero-pulse span {
        color: rgba(245, 236, 222, 0.7);
    }

    .hero-pulse strong {
        font-size: 1.15rem;
    }

    .hero-pulse-alert {
        background: linear-gradient(135deg, rgba(150,35,35,0.48), rgba(100,18,18,0.52));
        border-color: rgba(255,214,214,0.24);
    }

    .definition-grid,
    .cards,
    .camera-wall,
    .two-col {
        display: grid;
        gap: 16px;
    }

    .definition-grid {
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        margin-bottom: 18px;
    }

    .definition-card,
    .metric,
    .panel,
    .camera-card,
    .alert-card {
        background: rgba(255,250,242,0.9);
        border: 1px solid var(--line);
        border-radius: 24px;
        padding: 18px;
    }

    .definition-card p,
    .alert-card p,
    .camera-meta,
    .camera-preview-empty span,
    .detection-card span {
        color: var(--muted);
    }

    .panel-error {
        color: #912f2f;
        display: grid;
        gap: 8px;
    }

    .operational-empty {
        margin-bottom: 18px;
        display: grid;
        gap: 8px;
    }

    .cards {
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        margin-bottom: 18px;
    }

    .metric strong {
        display: block;
        margin-top: 10px;
        font-size: 2rem;
    }

    .metric-hot {
        background: linear-gradient(135deg, rgba(164,81,43,0.16), rgba(255,250,242,0.95));
    }

    .alert-strip {
        display: grid;
        gap: 12px;
        margin-bottom: 18px;
    }

    .alert-card {
        border-color: rgba(145, 47, 47, 0.28);
        background: linear-gradient(135deg, rgba(255,232,228,0.95), rgba(255,245,240,0.92));
    }

    .alert-card strong,
    .camera-alert strong {
        color: #7f1d1d;
    }

    .camera-wall {
        grid-template-columns: repeat(auto-fit, minmax(360px, 1fr));
        margin-bottom: 18px;
    }

    .camera-card {
        padding: 0;
        overflow: hidden;
        box-shadow: 0 14px 28px rgba(31, 42, 32, 0.08);
    }

    .camera-card-alert {
        border-color: rgba(145,47,47,0.36);
        box-shadow: 0 18px 36px rgba(127,29,29,0.12);
    }

    .camera-head,
    .camera-meta,
    .detection-panel,
    .camera-alert {
        padding-left: 18px;
        padding-right: 18px;
    }

    .camera-head {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        align-items: start;
        padding-top: 18px;
        padding-bottom: 12px;
    }

    .camera-status {
        display: inline-flex;
        align-items: center;
        padding: 8px 12px;
        border-radius: 999px;
        font-size: 0.85rem;
        border: 1px solid transparent;
    }

    .camera-status-live {
        background: rgba(44,106,74,0.12);
        color: var(--ok);
        border-color: rgba(44,106,74,0.2);
    }

    .camera-status-off {
        background: rgba(110,117,105,0.12);
        color: var(--muted);
        border-color: rgba(110,117,105,0.2);
    }

    .camera-preview {
        aspect-ratio: 16 / 10;
        background:
            linear-gradient(180deg, rgba(15,23,20,0.12), rgba(15,23,20,0.55)),
            linear-gradient(135deg, rgba(164,81,43,0.3), rgba(31,42,32,0.65));
        display: grid;
        place-items: center;
        overflow: hidden;
    }

    .camera-preview img,
    .detection-card img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }

    .camera-preview-empty {
        max-width: 28ch;
        text-align: center;
        display: grid;
        gap: 8px;
        padding: 18px;
        color: #f8f2e8;
    }

    .camera-meta {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        border-bottom: 1px solid rgba(216,203,182,0.6);
        font-size: 0.92rem;
        flex-wrap: wrap;
    }

    .camera-alert {
        padding-top: 14px;
        padding-bottom: 14px;
        background: linear-gradient(135deg, rgba(255,236,231,0.9), rgba(255,247,242,0.96));
        border-bottom: 1px solid rgba(216,203,182,0.6);
    }

    .camera-alert-head,
    .section-head,
    .row-link,
    .audit-row,
    .detection-card {
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .camera-alert-head,
    .section-head {
        align-items: center;
    }

    .camera-alert p {
        margin: 10px 0 0;
        color: #7f1d1d;
    }

    .detection-panel {
        padding-top: 18px;
        padding-bottom: 18px;
        display: grid;
        gap: 14px;
    }

    .detection-list {
        display: grid;
        gap: 12px;
    }

    .detection-card {
        align-items: stretch;
        padding: 12px;
        border-radius: 18px;
        background: rgba(255,255,255,0.55);
        border: 1px solid rgba(216,203,182,0.5);
    }

    .detection-card img {
        width: 108px;
        min-width: 108px;
        aspect-ratio: 1 / 1;
        border-radius: 14px;
    }

    .detection-card div {
        display: grid;
        gap: 6px;
    }

    .camera-empty {
        padding: 18px;
    }

    .two-col {
        grid-template-columns: 1fr 1fr;
    }

    .panel a,
    .section-head a,
    .row-link {
        text-decoration: none;
        color: inherit;
    }

    .row-link,
    .audit-row {
        padding: 12px 0;
        border-top: 1px solid rgba(216,203,182,0.6);
    }

    @@media (max-width: 1100px) {
        .hero,
        .two-col {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 720px) {
        .camera-wall {
            grid-template-columns: 1fr;
        }

        .detection-card {
            flex-direction: column;
        }

        .detection-card img {
            width: 100%;
            min-width: 0;
            aspect-ratio: 16 / 10;
        }
    }
</style>

@code {
    private OperationsSummaryModel? summary;
    private readonly Dictionary<Guid, string> evidenceUrls = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            summary = await PanelService.GetSummaryAsync();
            await LoadPreviewImagesAsync();
        }
        catch (Exception ex)
        {
            summary = null;
            loadError = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadPreviewImagesAsync()
    {
        if (summary is null)
        {
            return;
        }

        var previews = summary.CameraViews
            .Select(x => x.LatestSnapshot)
            .Concat(summary.CameraViews.SelectMany(x => x.RecentProtectedWomen.Select(y => y.Snapshot)))
            .Concat(summary.CameraViews.Select(x => x.ActiveAlert?.Snapshot))
            .Where(x => x is not null)
            .Cast<EvidencePreviewModel>()
            .GroupBy(x => x.EvidenceId)
            .Select(x => x.First())
            .ToArray();

        foreach (var preview in previews)
        {
            if (evidenceUrls.ContainsKey(preview.EvidenceId))
            {
                continue;
            }

            try
            {
                evidenceUrls[preview.EvidenceId] = await PanelService.GetIncidentEvidenceDataUrlAsync(
                    preview.IncidentId,
                    preview.EvidenceId,
                    preview.ContentType);
            }
            catch
            {
                evidenceUrls[preview.EvidenceId] = string.Empty;
            }
        }
    }

    private IEnumerable<CameraOperationalViewModel> OrderedCameraViews()
    {
        if (summary is null)
        {
            return Array.Empty<CameraOperationalViewModel>();
        }

        return summary.CameraViews
            .OrderByDescending(x => x.ActiveAlert is not null)
            .ThenBy(x => x.SiteName)
            .ThenBy(x => x.CameraName);
    }

    private string? GetEvidenceUrl(EvidencePreviewModel? preview)
    {
        if (preview is null)
        {
            return null;
        }

        return evidenceUrls.TryGetValue(preview.EvidenceId, out var dataUrl) && !string.IsNullOrWhiteSpace(dataUrl)
            ? dataUrl
            : null;
    }

    private static string DescribeRole(string subjectRole)
        => string.Equals(subjectRole, "Aggressor", StringComparison.OrdinalIgnoreCase)
            ? "Agressor monitorado"
            : "Mulher protegida";

    private static string DescribeIncidentStatus(string incidentStatus)
    {
        return incidentStatus switch
        {
            "Confirmed" => "Confirmado",
            "Dismissed" => "Descartado",
            "Escalated" => "Escalonado",
            _ => "Em revisao"
        };
    }
}
