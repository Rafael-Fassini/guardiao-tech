@page "/incidents"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Incidentes</PageTitle>

<section class="page-header">
    <div>
        <div class="page-kicker">Operacao</div>
        <h1>Incidentes</h1>
        <p class="page-subtitle">Fila operacional de ocorrencias geradas pela correlacao biometrica e aguardando tratamento humano.</p>
    </div>
</section>

<section class="table-panel">
    @if (isLoading)
    {
        <p class="panel-empty">Carregando incidentes.</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p class="panel-empty panel-error">@loadError</p>
    }
    else if (items.Count == 0)
    {
        <p class="panel-empty">Nenhum incidente disponivel.</p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Status</th>
                    <th>Caso</th>
                    <th>Criado em</th>
                    <th>Escalado em</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var incident in items)
                {
                    <tr>
                        <td>@incident.Id.ToString()[..8]</td>
                        <td><span class="@GetStatusClass(incident.Status)">@DescribeIncidentStatus(incident.Status)</span></td>
                        <td>@incident.ProtectedCaseId.ToString()[..8]</td>
                        <td>@incident.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        <td>@(incident.EscalatedAtUtc?.ToLocalTime().ToString("dd/MM HH:mm") ?? "-")</td>
                        <td><a class="action-link" href="/incidents/@incident.Id">Abrir</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<style>
    .panel-error {
        color: #912f2f;
    }
</style>

@code {
    private List<IncidentListItemModel> items = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            items = await PanelService.ListIncidentsAsync();
        }
        catch (Exception ex)
        {
            items = [];
            loadError = $"Nao foi possivel carregar os incidentes: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string DescribeIncidentStatus(string incidentStatus)
    {
        return incidentStatus switch
        {
            "Confirmed" => "Confirmado",
            "Dismissed" => "Descartado",
            "Escalated" => "Escalonado",
            _ => "Em revisao"
        };
    }

    private static string GetStatusClass(string incidentStatus)
    {
        return incidentStatus switch
        {
            "Confirmed" => "status-badge status-ok",
            "Dismissed" => "status-badge status-neutral",
            "Escalated" => "status-badge status-danger",
            _ => "status-badge status-warn"
        };
    }
}
