@page "/cases/{Id:guid}"
@attribute [Authorize(Roles = "operator,admin")]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services
@using Microsoft.AspNetCore.Components.Forms

<PageTitle>Regras do caso</PageTitle>

@if (isLoading)
{
    <p class="panel-empty">Carregando caso monitorado.</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <p class="panel-empty panel-error">@loadError</p>
}
else if (item is null)
{
    <p class="panel-empty">Caso nao encontrado.</p>
}
else
{
    <section class="page-header">
        <div>
            <div class="page-kicker">Configuracao operacional</div>
            <h1>Regras do caso @item.ExternalCaseId</h1>
            <p class="page-subtitle">Classificacao, biometria e regras de monitoramento aplicadas ao caso protegido neste piloto.</p>
        </div>
        <div>
            <span class="@GetRoleClass(selectedSubjectRole)">@DescribeRole(selectedSubjectRole)</span>
        </div>
    </section>

    <section class="rule-card">
        <div class="rule-head">
            <strong>Classificacao operacional</strong>
            <span class="@GetRoleClass(selectedSubjectRole)">@DescribeRole(selectedSubjectRole)</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(subjectRoleMessage))
        {
            <p class="panel-success">@subjectRoleMessage</p>
        }
        <div class="subject-role-row">
            <label>
                <span class="field-label">Perfil monitorado</span>
                <select class="field-select" @bind="selectedSubjectRole">
                    <option value="ProtectedWoman">Mulher protegida</option>
                    <option value="Aggressor">Agressor monitorado</option>
                </select>
            </label>
            <button class="btn-primary" type="button" @onclick="SaveSubjectRoleAsync">Salvar classificacao</button>
        </div>
    </section>

    <section class="rule-card">
        <div class="rule-head">
            <strong>Biometria cadastrada</strong>
            <span>@templates.Count item(ns)</span>
        </div>
        @if (!string.IsNullOrWhiteSpace(uploadError))
        {
            <p class="panel-error">@uploadError</p>
        }
        @if (!string.IsNullOrWhiteSpace(uploadSuccess))
        {
            <p class="panel-success">@uploadSuccess</p>
        }
        <div class="upload-row">
            <InputFile OnChange="HandleFileSelected" accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />
            <button class="btn-primary" type="button" @onclick="UploadBiometricAsync" disabled="@(selectedFile is null)">Enviar imagem</button>
        </div>
        @if (templates.Count == 0)
        {
            <p class="panel-empty">Nenhum template biometrico cadastrado.</p>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Arquivo</th>
                        <th>Origem</th>
                        <th>Tipo</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var template in templates)
                    {
                        <tr>
                            <td>@template.DisplayName</td>
                            <td>@template.Source</td>
                            <td>@template.ContentType</td>
                            <td><span class="@(template.IsActive ? "status-badge status-ok" : "status-badge status-neutral")">@(template.IsActive ? "Ativo" : "Inativo")</span></td>
                            <td>
                                @if (template.IsActive)
                                {
                                    <button class="btn-secondary" type="button" @onclick="@(() => DeactivateTemplateAsync(template.Id))">Desativar</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @foreach (var rule in rules)
    {
        var model = editModels[rule.Id];
        <section class="rule-card">
            <div class="rule-head">
                <strong>@rule.Id.ToString()[..8]</strong>
                <span class="@(rule.IsEnabled ? "status-badge status-ok" : "status-badge status-neutral")">@(rule.IsEnabled ? "Ativa" : "Inativa")</span>
            </div>
            <EditForm Model="@model" FormName="@model.FormName" OnValidSubmit="@(() => SaveRule(model))">
                <div class="rule-grid">
                    <div>
                        <label class="field-label">Site</label>
                        <input class="field-input" value="@rule.SiteId" disabled />
                    </div>
                    <div>
                        <label class="field-label">Camera</label>
                        <input class="field-input" value="@rule.CameraId" disabled />
                    </div>
                    <div>
                        <label class="field-label">Inicio</label>
                        <InputText class="field-input" @bind-Value="model.StartsAtText" />
                    </div>
                    <div>
                        <label class="field-label">Fim</label>
                        <InputText class="field-input" @bind-Value="model.EndsAtText" />
                    </div>
                </div>
                <label class="toggle field-label">
                    <InputCheckbox @bind-Value="model.Enabled" />
                    Regra habilitada
                </label>
                <button class="btn-primary" type="submit">Salvar regra</button>
            </EditForm>
        </section>
    }
}

<style>
    .rule-card {
        background: var(--panel);
        border: 1px solid rgba(189, 168, 139, 0.68);
        border-radius: 24px;
        padding: 18px;
        margin-bottom: 14px;
        box-shadow: var(--shadow-soft);
    }

    .rule-head {
        display: flex;
        justify-content: space-between;
        margin-bottom: 14px;
    }

    .rule-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 12px;
        margin-bottom: 12px;
    }

    .rule-grid label, .toggle {
        display: grid;
        gap: 6px;
    }

    .subject-role-row {
        display: flex;
        gap: 12px;
        align-items: end;
        flex-wrap: wrap;
    }

    .subject-role-row label {
        display: grid;
        gap: 6px;
        min-width: 260px;
    }

    .upload-row {
        display: flex;
        gap: 12px;
        align-items: center;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .panel-error {
        color: #912f2f;
    }

    .panel-success {
        color: #1f6b3b;
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private ProtectedCaseDetailModel? item;
    private List<MonitoringRuleModel> rules = [];
    private List<BiometricTemplateModel> templates = [];
    private readonly Dictionary<Guid, RuleEditModel> editModels = [];
    private IBrowserFile? selectedFile;
    private string? uploadError;
    private string? uploadSuccess;
    private string selectedSubjectRole = "ProtectedWoman";
    private string? subjectRoleMessage;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            item = await PanelService.GetCaseAsync(Id);
            if (item is null)
            {
                rules = [];
                templates = [];
                editModels.Clear();
                return;
            }

            selectedSubjectRole = item.SubjectRole;
            subjectRoleMessage = null;
            rules = await PanelService.ListRulesAsync(Id);
            templates = await PanelService.ListBiometricTemplatesAsync(Id);
            editModels.Clear();
            foreach (var rule in rules)
            {
                editModels[rule.Id] = new RuleEditModel(rule);
            }
        }
        catch (Exception ex)
        {
            item = null;
            rules = [];
            templates = [];
            editModels.Clear();
            loadError = $"Nao foi possivel carregar o caso monitorado: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task SaveSubjectRoleAsync()
    {
        await PanelService.UpdateCaseSubjectRoleAsync(Id, selectedSubjectRole);
        item = await PanelService.GetCaseAsync(Id);
        selectedSubjectRole = item?.SubjectRole ?? selectedSubjectRole;
        subjectRoleMessage = "Classificacao operacional atualizada.";
    }

    private async Task SaveRule(RuleEditModel model)
    {
        await PanelService.UpdateRuleAsync(
            Id,
            model.Id,
            model.SiteId,
            model.CameraId,
            TimeOnly.Parse(model.StartsAtText),
            TimeOnly.Parse(model.EndsAtText),
            model.Enabled);
    }

    private void HandleFileSelected(InputFileChangeEventArgs args)
    {
        selectedFile = args.File;
        uploadError = null;
        uploadSuccess = null;
    }

    private async Task UploadBiometricAsync()
    {
        if (selectedFile is null)
        {
            uploadError = "Selecione uma imagem antes de enviar.";
            uploadSuccess = null;
            return;
        }

        try
        {
            await PanelService.UploadBiometricTemplateAsync(Id, selectedFile);
            templates = await PanelService.ListBiometricTemplatesAsync(Id);
            uploadSuccess = "Template biometrico cadastrado.";
            uploadError = null;
            selectedFile = null;
        }
        catch (Exception ex)
        {
            uploadError = ex.Message;
            uploadSuccess = null;
        }
    }

    private async Task DeactivateTemplateAsync(Guid templateId)
    {
        await PanelService.DeactivateBiometricTemplateAsync(Id, templateId);
        templates = await PanelService.ListBiometricTemplatesAsync(Id);
    }

    private static string DescribeRole(string subjectRole)
        => string.Equals(subjectRole, "Aggressor", StringComparison.OrdinalIgnoreCase)
            ? "Agressor monitorado"
            : "Mulher protegida";

    private static string GetRoleClass(string subjectRole)
        => string.Equals(subjectRole, "Aggressor", StringComparison.OrdinalIgnoreCase)
            ? "role-chip status-danger"
            : "role-chip status-ok";

    private sealed class RuleEditModel
    {
        public RuleEditModel(MonitoringRuleModel rule)
        {
            Id = rule.Id;
            SiteId = rule.SiteId;
            CameraId = rule.CameraId;
            StartsAtText = rule.StartsAt.ToString("HH\\:mm");
            EndsAtText = rule.EndsAt.ToString("HH\\:mm");
            Enabled = rule.IsEnabled;
        }

        public Guid Id { get; }
        public string FormName => $"monitoring-rule-{Id:N}";
        public Guid SiteId { get; }
        public Guid CameraId { get; }
        public string StartsAtText { get; set; }
        public string EndsAtText { get; set; }
        public bool Enabled { get; set; }
    }
}
