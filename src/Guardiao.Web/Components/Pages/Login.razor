@page "/login"
@using Guardiao.Infrastructure.Options
@inject IOptions<WebSecurityOptions> SecurityOptions

<PageTitle>Entrar</PageTitle>

<div class="login-shell">
    <section class="login-card">
        <div class="page-kicker">Guardiao Ops</div>
        <h1>Centro de operacoes</h1>
        <p class="lead">Acesso ao painel operacional do piloto com resumo visual, tratamento de incidentes, regras e auditoria.</p>
        <div class="login-banner">
            <strong>Modo de piloto controlado</strong>
            <span>Use um perfil operacional para navegar por incidentes, casos monitorados e ambientes observados.</span>
        </div>

        @if (!SecurityOptions.Value.EnableOperationsDemoLogin)
        {
            <p class="lead panel-error">O login local desta interface foi desabilitado por configuracao.</p>
        }
        <form method="post" action="/operations/login">
            <div class="field">
                <label class="field-label" for="userName">Usuario</label>
                <input class="field-input" id="userName" name="userName" value="@model.UserName" />
            </div>
            <div class="field">
                <label class="field-label" for="role">Perfil</label>
                <select class="field-select" id="role" name="role">
                    <option value="operator" selected="@(model.Role == "operator")">Operator</option>
                    <option value="admin" selected="@(model.Role == "admin")">Admin</option>
                    <option value="auditor" selected="@(model.Role == "auditor")">Auditor</option>
                </select>
            </div>
            <button class="btn-primary submit" type="submit" disabled="@(!SecurityOptions.Value.EnableOperationsDemoLogin)">Iniciar sessao</button>
        </form>
    </section>
</div>

<style>
    .login-shell {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: 24px;
    }

    .login-card {
        width: min(560px, 100%);
        background:
            linear-gradient(180deg, rgba(255,250,242,0.96), rgba(251,244,234,0.94)),
            linear-gradient(135deg, rgba(155,79,45,0.08), transparent);
        border: 1px solid rgba(213,195,167,0.9);
        border-radius: 32px;
        padding: 34px;
        box-shadow: var(--shadow);
    }

    .lead {
        color: var(--muted);
        line-height: 1.5;
    }

    .login-banner {
        display: grid;
        gap: 6px;
        margin: 18px 0 22px;
        padding: 16px 18px;
        border-radius: 20px;
        background: linear-gradient(135deg, rgba(24,35,29,0.94), rgba(55,80,67,0.92));
        color: #f5ecde;
        box-shadow: var(--shadow-soft);
    }

    .field {
        display: grid;
        gap: 8px;
        margin: 16px 0;
    }

    .submit {
        width: 100%;
        margin-top: 8px;
    }
</style>

@code {
    private readonly LoginModel model = new()
    {
        UserName = "operator.ana",
        Role = "operator"
    };

    private sealed class LoginModel
    {
        public string UserName { get; set; } = string.Empty;
        public string Role { get; set; } = string.Empty;
    }
}
