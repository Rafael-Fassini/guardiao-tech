@page "/audit"
@attribute [Authorize(Roles = "auditor,admin,operator")]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Auditoria</PageTitle>

<section class="page-header">
    <div>
        <div class="page-kicker">Conformidade</div>
        <h1>Trilha de auditoria</h1>
        <p class="page-subtitle">Registro cronologico das acoes operacionais, administrativas e automatizadas relevantes para o piloto.</p>
    </div>
</section>

<section class="panel">
    @if (isLoading)
    {
        <p class="panel-empty">Carregando trilha de auditoria.</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p class="panel-empty panel-error">@loadError</p>
    }
    else if (entries.Count == 0)
    {
        <p class="panel-empty">Nenhum registro disponivel.</p>
    }
    else
    {
        @foreach (var entry in entries)
        {
            <article class="audit-card">
                <div class="audit-top">
                    <strong>@entry.Action</strong>
                    <span class="status-badge status-neutral">@entry.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                </div>
                <div class="audit-meta">@entry.EntityName / @entry.EntityId</div>
                <p>@entry.Details</p>
            </article>
        }
    }
</section>

<style>
    .audit-card {
        display: grid;
        gap: 8px;
        border: 1px solid rgba(213,195,167,0.62);
        border-radius: 20px;
        padding: 18px;
        background: rgba(255,255,255,0.4);
    }

    .audit-top {
        display: flex;
        justify-content: space-between;
        gap: 12px;
    }

    .audit-meta {
        color: var(--muted);
        font-size: 0.92rem;
    }

    .panel-error {
        color: #912f2f;
    }
</style>

@code {
    private List<AuditEntryModel> entries = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            entries = await PanelService.ListAuditAsync();
        }
        catch (Exception ex)
        {
            entries = [];
            loadError = $"Nao foi possivel carregar a auditoria: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
