@page "/cameras"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Cameras e sites</PageTitle>

<section class="page-header">
    <div>
        <div class="page-kicker">Infraestrutura</div>
        <h1>Cameras e sites</h1>
        <p class="page-subtitle">Mapa operacional dos ambientes monitorados, com origem do stream e controle de habilitacao por camera.</p>
    </div>
</section>

<div class="split-grid">
    <section class="panel">
        <h2>Sites</h2>
        @if (isLoading)
        {
            <p class="panel-empty">Carregando sites e cameras.</p>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <p class="panel-empty panel-error">@loadError</p>
        }
        else if (sites.Count == 0)
        {
            <p class="panel-empty">Nenhum site disponivel.</p>
        }
        else
        {
            @foreach (var site in sites)
            {
                <article class="site-card">
                    <strong>@site.Name</strong>
                    <span class="meta-text">@site.AddressLine</span>
                </article>
            }
        }
    </section>

    <section class="panel">
        <h2>Cameras</h2>
        @if (!isLoading && string.IsNullOrWhiteSpace(loadError) && cameras.Count == 0)
        {
            <p class="panel-empty">Nenhuma camera disponivel.</p>
        }
        else
        {
            @foreach (var camera in cameras)
            {
                <article class="camera-row">
                    <div>
                        <strong>@camera.Name</strong>
                        <div class="meta-text">@camera.StreamEndpoint</div>
                    </div>
                    <div class="camera-actions">
                        <span class="@(camera.IsEnabled ? "status-badge status-ok" : "status-badge status-neutral")">
                            @(camera.IsEnabled ? "Ativa" : "Inativa")
                        </span>
                        <button class="btn-secondary" @onclick="() => Toggle(camera)">@((camera.IsEnabled ? "Desabilitar" : "Habilitar"))</button>
                    </div>
                </article>
            }
        }
    </section>
</div>

<style>
    .site-card,
    .camera-row {
        display: flex;
        justify-content: space-between;
        gap: 14px;
        padding: 16px 0;
        border-top: 1px solid rgba(213,195,167,0.58);
        align-items: center;
    }

    .panel-error {
        color: #912f2f;
    }

    .camera-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
    }
</style>

@code {
    private List<SiteModel> sites = [];
    private List<CameraModel> cameras = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task Toggle(CameraModel camera)
    {
        try
        {
            await PanelService.ToggleCameraAsync(camera.Id, !camera.IsEnabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Nao foi possivel atualizar o estado da camera: {ex.Message}";
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            sites = await PanelService.ListSitesAsync();
            cameras = await PanelService.ListCamerasAsync();
        }
        catch (Exception ex)
        {
            sites = [];
            cameras = [];
            loadError = $"Nao foi possivel carregar sites e cameras: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
