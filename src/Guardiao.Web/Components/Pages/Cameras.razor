@page "/cameras"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Cameras e sites</PageTitle>
<h1>Cameras e sites</h1>

<div class="split">
    <section class="panel">
        <h2>Sites</h2>
        @if (isLoading)
        {
            <p class="panel-empty">Carregando sites e cameras.</p>
        }
        else if (!string.IsNullOrWhiteSpace(loadError))
        {
            <p class="panel-empty panel-error">@loadError</p>
        }
        else if (sites.Count == 0)
        {
            <p class="panel-empty">Nenhum site disponivel.</p>
        }
        else
        {
            @foreach (var site in sites)
            {
                <div class="row">
                    <strong>@site.Name</strong>
                    <span>@site.AddressLine</span>
                </div>
            }
        }
    </section>

    <section class="panel">
        <h2>Cameras</h2>
        @if (!isLoading && string.IsNullOrWhiteSpace(loadError) && cameras.Count == 0)
        {
            <p class="panel-empty">Nenhuma camera disponivel.</p>
        }
        else
        {
            @foreach (var camera in cameras)
            {
                <div class="camera-row">
                    <div>
                        <strong>@camera.Name</strong>
                        <div class="muted">@camera.StreamEndpoint</div>
                    </div>
                    <button class="ghost" @onclick="() => Toggle(camera)">@((camera.IsEnabled ? "Desabilitar" : "Habilitar"))</button>
                </div>
            }
        }
    </section>
</div>

<style>
    .split {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .panel {
        background: rgba(255,250,242,0.88);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 18px;
    }

    .row, .camera-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 12px 0;
        border-top: 1px solid rgba(216,203,182,0.6);
    }

    .muted {
        color: var(--muted);
        font-size: 0.92rem;
    }

    .panel-error {
        color: #912f2f;
    }

    @@media (max-width: 900px) {
        .split {
            grid-template-columns: 1fr;
        }
    }
</style>

@code {
    private List<SiteModel> sites = [];
    private List<CameraModel> cameras = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task Toggle(CameraModel camera)
    {
        try
        {
            await PanelService.ToggleCameraAsync(camera.Id, !camera.IsEnabled);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            loadError = $"Nao foi possivel atualizar o estado da camera: {ex.Message}";
        }
    }

    private async Task LoadAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            sites = await PanelService.ListSitesAsync();
            cameras = await PanelService.ListCamerasAsync();
        }
        catch (Exception ex)
        {
            sites = [];
            cameras = [];
            loadError = $"Nao foi possivel carregar sites e cameras: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }
}
