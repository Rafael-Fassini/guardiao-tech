@page "/cases"
@attribute [Authorize]
@inject OperationsPanelService PanelService

<PageTitle>Casos</PageTitle>
<h1>Casos monitorados</h1>

<section class="table-panel">
    @if (items.Count == 0)
    {
        <p class="panel-empty">Nenhum caso sincronizado.</p>
    }
    else
    {
        <table class="grid">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Externo</th>
                    <th>Status</th>
                    <th>Versao</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Id.ToString()[..8]</td>
                        <td>@item.ExternalCaseId</td>
                        <td>@item.MonitoringStatus</td>
                        <td>@item.Version</td>
                        <td><a href="/cases/@item.Id">Regras</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<style>
    .table-panel {
        background: rgba(255,250,242,0.88);
        border: 1px solid var(--line);
        border-radius: 22px;
        padding: 18px;
    }

    .grid {
        width: 100%;
        border-collapse: collapse;
    }

    .grid th, .grid td {
        padding: 12px 10px;
        border-bottom: 1px solid rgba(216,203,182,0.6);
        text-align: left;
    }
</style>

@code {
    private List<Guardiao.Domain.Entities.ProtectedCase> items = [];

    protected override async Task OnInitializedAsync()
    {
        items = await PanelService.ListCasesAsync();
    }
}
