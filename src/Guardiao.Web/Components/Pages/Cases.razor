@page "/cases"
@attribute [Authorize]
@inject OperationsPanelService PanelService
@using Guardiao.Web.Services

<PageTitle>Casos</PageTitle>

<section class="page-header">
    <div>
        <div class="page-kicker">Monitoramento</div>
        <h1>Casos monitorados</h1>
        <p class="page-subtitle">Cadastro operacional das pessoas acompanhadas pelo piloto, com classificacao, status e acesso as regras por camera.</p>
    </div>
</section>

<section class="table-panel">
    @if (isLoading)
    {
        <p class="panel-empty">Carregando casos monitorados.</p>
    }
    else if (!string.IsNullOrWhiteSpace(loadError))
    {
        <p class="panel-empty panel-error">@loadError</p>
    }
    else if (items.Count == 0)
    {
        <p class="panel-empty">Nenhum caso sincronizado.</p>
    }
    else
    {
        <table class="data-grid">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Externo</th>
                    <th>Perfil</th>
                    <th>Status</th>
                    <th>Versao</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in items)
                {
                    <tr>
                        <td>@item.Id.ToString()[..8]</td>
                        <td>@item.ExternalCaseId</td>
                        <td><span class="@GetRoleClass(item.SubjectRole)">@DescribeRole(item.SubjectRole)</span></td>
                        <td><span class="@GetMonitoringStatusClass(item.MonitoringStatus)">@item.MonitoringStatus</span></td>
                        <td>@item.Version</td>
                        <td><a class="action-link" href="/cases/@item.Id">Regras</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>

<style>
    .panel-error {
        color: #912f2f;
    }
</style>

@code {
    private List<ProtectedCaseListItemModel> items = [];
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            items = await PanelService.ListCasesAsync();
        }
        catch (Exception ex)
        {
            items = [];
            loadError = $"Nao foi possivel carregar os casos monitorados: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private static string DescribeRole(string subjectRole)
        => string.Equals(subjectRole, "Aggressor", StringComparison.OrdinalIgnoreCase)
            ? "Agressor monitorado"
            : "Mulher protegida";

    private static string GetRoleClass(string subjectRole)
        => string.Equals(subjectRole, "Aggressor", StringComparison.OrdinalIgnoreCase)
            ? "role-chip status-danger"
            : "role-chip status-ok";

    private static string GetMonitoringStatusClass(string monitoringStatus)
    {
        return monitoringStatus.ToLowerInvariant() switch
        {
            "enabled" => "status-badge status-ok",
            "suspended" => "status-badge status-warn",
            "revoked" => "status-badge status-danger",
            _ => "status-badge status-neutral"
        };
    }
}
