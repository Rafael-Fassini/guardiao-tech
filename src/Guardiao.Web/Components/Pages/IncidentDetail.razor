@page "/incidents/{Id:guid}"
@attribute [Authorize(Roles = "operator,admin")]
@inject OperationsPanelService PanelService
@inject NavigationManager Navigation
@using Guardiao.Web.Services

<PageTitle>Detalhe do incidente</PageTitle>

@if (isLoading)
{
    <p class="panel-empty">Carregando incidente.</p>
}
else if (!string.IsNullOrWhiteSpace(loadError))
{
    <p class="panel-empty panel-error">@loadError</p>
}
else if (incident is null)
{
    <p class="panel-empty">Incidente nao encontrado.</p>
}
else
{
    <section class="page-header">
        <div>
            <div class="page-kicker">Resposta operacional</div>
            <h1>Incidente @incident.Id.ToString()[..8]</h1>
            <p class="page-subtitle">Validacao humana, evidencias e historico operacional associados a uma ocorrencia biometrica.</p>
        </div>
        <div>
            <span class="@GetStatusClass(incident.Status)">@DescribeIncidentStatus(incident.Status)</span>
        </div>
    </section>

    @if (string.Equals(incident.Status, "Escalated", StringComparison.OrdinalIgnoreCase))
    {
        <section class="risk-banner">
            <strong>Incidente em prioridade alta</strong>
            <span>Este caso ja foi escalonado e exige rastreabilidade reforcada durante a tratativa.</span>
        </section>
    }

    <div class="split-grid">
        <section class="panel">
            <h2>Estado</h2>
            <dl>
                <dt>Status</dt>
                <dd><span class="@GetStatusClass(incident.Status)">@DescribeIncidentStatus(incident.Status)</span></dd>
                <dt>Caso</dt>
                <dd>@incident.ProtectedCaseId</dd>
                <dt>Criado</dt>
                <dd>@incident.CreatedAtUtc.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>
                <dt>Escalonado</dt>
                <dd>@(incident.EscalatedAtUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Nao")</dd>
                <dt>Evidencias</dt>
                <dd>@evidences.Count</dd>
            </dl>
        </section>

        <section class="panel">
            <h2>Validacao humana</h2>
            <textarea class="field-textarea" @bind="reviewNotes" rows="5"></textarea>
            <div class="actions">
                <button class="btn-primary" @onclick="Confirm">Confirmar</button>
                <button class="btn-danger" @onclick="Dismiss">Descartar</button>
            </div>
        </section>
    </div>

    <section class="panel evidence-panel">
        <h2>Evidencias</h2>
        @if (evidences.Count == 0)
        {
            <p class="panel-empty">Nenhuma evidencia vinculada a este incidente.</p>
        }
        else
        {
            <div class="evidence-grid">
                @foreach (var evidence in evidences)
                {
                    <article class="evidence-card">
                        <div class="evidence-head">
                            <strong>@evidence.ArtifactType</strong>
                            <span class="status-badge status-neutral">@evidence.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</span>
                        </div>
                        @if (evidenceDataUrls.TryGetValue(evidence.Id, out var dataUrl))
                        {
                            <img src="@dataUrl" alt="@evidence.ArtifactType" />
                        }
                    </article>
                }
            </div>
        }
    </section>

    <section class="panel evidence-panel">
        <h2>Notificacoes operacionais</h2>
        @if (notifications.Count == 0)
        {
            <p class="panel-empty">Nenhuma notificacao registrada para este incidente.</p>
        }
        else
        {
            <table class="data-grid">
                <thead>
                    <tr>
                        <th>Evento</th>
                        <th>Canal</th>
                        <th>Status</th>
                        <th>Tentativas</th>
                        <th>Evidencia</th>
                        <th>Horario</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var notification in notifications)
                    {
                        <tr>
                            <td>@notification.EventType</td>
                            <td>@notification.Channel</td>
                            <td><span class="@GetNotificationClass(notification.DeliveryStatus)">@notification.DeliveryStatus</span></td>
                            <td>@notification.AttemptCount</td>
                            <td>@(notification.HasEvidence ? "Sim" : "Nao")</td>
                            <td>@notification.CreatedAtUtc.ToLocalTime().ToString("dd/MM HH:mm")</td>
                        </tr>
                        @if (!string.IsNullOrWhiteSpace(notification.Details))
                        {
                            <tr>
                                <td colspan="6" class="details-row">@notification.Details</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }
    </section>
}

<style>
    dl {
        display: grid;
        grid-template-columns: 120px 1fr;
        gap: 10px 14px;
    }

    dt {
        color: var(--muted);
    }

    .actions {
        display: flex;
        gap: 10px;
        margin-top: 12px;
        flex-wrap: wrap;
    }

    .evidence-panel {
        margin-top: 16px;
    }

    .evidence-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 14px;
    }

    .evidence-card {
        display: grid;
        gap: 8px;
        border: 1px solid rgba(213,195,167,0.62);
        border-radius: 18px;
        padding: 12px;
        background: rgba(255,255,255,0.52);
    }

    .evidence-head {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        align-items: center;
    }

    .evidence-card img {
        width: 100%;
        border-radius: 14px;
        border: 1px solid var(--line);
        object-fit: cover;
        background: #f3ede4;
    }

    .details-row {
        color: var(--muted);
        font-size: 0.92rem;
        background: rgba(255, 254, 251, 0.72);
    }
</style>

@code {
    [Parameter] public Guid Id { get; set; }

    private IncidentDetailModel? incident;
    private List<IncidentEvidenceModel> evidences = [];
    private List<IncidentNotificationModel> notifications = [];
    private readonly Dictionary<Guid, string> evidenceDataUrls = [];
    private string reviewNotes = string.Empty;
    private bool isLoading = true;
    private string? loadError;

    protected override async Task OnParametersSetAsync()
    {
        isLoading = true;
        loadError = null;

        try
        {
            incident = await PanelService.GetIncidentAsync(Id);
            evidences = incident is null
                ? []
                : await PanelService.ListIncidentEvidencesAsync(Id);
            notifications = incident is null
                ? []
                : await PanelService.ListIncidentNotificationsAsync(Id);
            evidenceDataUrls.Clear();
            foreach (var evidence in evidences)
            {
                try
                {
                    evidenceDataUrls[evidence.Id] = await PanelService.GetIncidentEvidenceDataUrlAsync(Id, evidence.Id, evidence.ContentType);
                }
                catch
                {
                    // Keep the incident detail page usable even if one artifact cannot be loaded.
                }
            }
        }
        catch (Exception ex)
        {
            incident = null;
            evidences = [];
            notifications = [];
            evidenceDataUrls.Clear();
            loadError = $"Nao foi possivel carregar o incidente: {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task Confirm()
    {
        await PanelService.ConfirmIncidentAsync(Id, reviewNotes);
        Navigation.NavigateTo("/incidents", true);
    }

    private async Task Dismiss()
    {
        await PanelService.DismissIncidentAsync(Id, reviewNotes);
        Navigation.NavigateTo("/incidents", true);
    }

    private static string DescribeIncidentStatus(string incidentStatus)
    {
        return incidentStatus switch
        {
            "Confirmed" => "Confirmado",
            "Dismissed" => "Descartado",
            "Escalated" => "Escalonado",
            _ => "Em revisao"
        };
    }

    private static string GetStatusClass(string incidentStatus)
    {
        return incidentStatus switch
        {
            "Confirmed" => "status-badge status-ok",
            "Dismissed" => "status-badge status-neutral",
            "Escalated" => "status-badge status-danger",
            _ => "status-badge status-warn"
        };
    }

    private static string GetNotificationClass(string deliveryStatus)
    {
        return deliveryStatus.ToLowerInvariant() switch
        {
            "sent" or "delivered" or "success" => "status-badge status-ok",
            "failed" or "error" => "status-badge status-danger",
            _ => "status-badge status-warn"
        };
    }
}
