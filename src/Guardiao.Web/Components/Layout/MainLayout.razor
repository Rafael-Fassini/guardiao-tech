@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">G</span>
            <div>
                <div class="brand-name">Guardiao Ops</div>
                <div class="brand-sub">Painel operacional</div>
            </div>
        </div>

        <nav class="nav">
            <NavLink href="/" Match="NavLinkMatch.All">Resumo</NavLink>
            <NavLink href="/incidents">Incidentes</NavLink>
            <NavLink href="/cases">Casos</NavLink>
            <NavLink href="/cameras">Cameras</NavLink>
            <NavLink href="/audit">Auditoria</NavLink>
        </nav>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="session">
                    <div class="session-user">@authState.User.Identity?.Name</div>
                    <div class="session-role">@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    <form method="post" action="/operations/logout">
                        <button class="ghost" type="submit">Encerrar sessao</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="session">
                    <button class="ghost" @onclick="GoLogin">Entrar</button>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<style>
    :root {
        --bg: #efe8db;
        --bg-strong: #e5dbc9;
        --panel: rgba(255, 249, 239, 0.92);
        --panel-strong: #fffaf2;
        --line: #d5c3a7;
        --line-strong: #bda88b;
        --text: #18231d;
        --muted: #667064;
        --accent: #9b4f2d;
        --accent-soft: rgba(155, 79, 45, 0.12);
        --accent-strong: #6f341c;
        --ok: #2f6f4f;
        --warn: #946419;
        --danger: #8b3028;
        --shadow: 0 18px 44px rgba(36, 29, 22, 0.12);
        --shadow-soft: 0 12px 28px rgba(36, 29, 22, 0.08);
    }

    body {
        margin: 0;
        font-family: "Palatino Linotype", "Book Antiqua", Georgia, serif;
        background:
            radial-gradient(circle at top left, rgba(155,79,45,0.2), transparent 28%),
            radial-gradient(circle at bottom right, rgba(24,35,29,0.08), transparent 24%),
            linear-gradient(180deg, #f5efe4, #ebe1cf);
        color: var(--text);
    }

    .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px 1fr;
    }

    .sidebar {
        border-right: 1px solid rgba(189, 168, 139, 0.55);
        padding: 24px 20px;
        background:
            linear-gradient(180deg, rgba(255,250,242,0.95), rgba(248,241,229,0.9)),
            linear-gradient(135deg, rgba(155,79,45,0.04), transparent);
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        gap: 28px;
        box-shadow: inset -1px 0 0 rgba(255,255,255,0.3);
    }

    .brand {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        color: #fff8ef;
        font-weight: 700;
        box-shadow: var(--shadow-soft);
    }

    .brand-name {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .brand-sub, .session-role {
        color: var(--muted);
        font-size: 0.9rem;
    }

    .nav {
        display: grid;
        gap: 8px;
    }

    .nav a {
        color: var(--text);
        text-decoration: none;
        padding: 12px 14px;
        border-radius: 16px;
        border: 1px solid transparent;
        transition: 140ms ease;
    }

    .nav a.active {
        background: linear-gradient(135deg, rgba(155,79,45,0.14), rgba(155,79,45,0.06));
        border-color: rgba(189, 168, 139, 0.7);
        box-shadow: inset 0 0 0 1px rgba(255,255,255,0.35);
    }

    .nav a:hover {
        background: rgba(255,255,255,0.44);
        border-color: rgba(189, 168, 139, 0.42);
    }

    .content {
        padding: 28px;
    }

    .session {
        margin-top: auto;
        display: grid;
        gap: 8px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
    }

    .session-user {
        font-weight: 700;
    }

    .ghost {
        border: 1px solid var(--line);
        background: rgba(255,255,255,0.35);
        padding: 10px 14px;
        border-radius: 999px;
        cursor: pointer;
        color: var(--text);
    }

    .ghost:hover {
        background: rgba(255,255,255,0.6);
    }

    .content h1 {
        margin-top: 0;
        margin-bottom: 10px;
        font-size: clamp(2rem, 3vw, 2.7rem);
        letter-spacing: -0.03em;
    }

    .content h2 {
        margin-top: 0;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        gap: 18px;
        align-items: end;
        margin-bottom: 18px;
    }

    .page-kicker {
        text-transform: uppercase;
        letter-spacing: 0.16em;
        font-size: 0.72rem;
        color: var(--accent);
        margin-bottom: 8px;
    }

    .page-subtitle {
        margin: 0;
        color: var(--muted);
        max-width: 72ch;
        line-height: 1.55;
    }

    .surface,
    .table-panel,
    .panel {
        background: var(--panel);
        border: 1px solid rgba(189, 168, 139, 0.68);
        border-radius: 24px;
        padding: 20px;
        box-shadow: var(--shadow-soft);
    }

    .surface-muted {
        background: rgba(255, 252, 247, 0.72);
    }

    .panel-empty {
        padding: 22px;
        border: 1px dashed rgba(189, 168, 139, 0.9);
        border-radius: 18px;
        background: rgba(255,255,255,0.38);
        color: var(--muted);
    }

    .panel-error,
    .error-state {
        color: var(--danger);
    }

    .panel-success,
    .success-state {
        color: var(--ok);
    }

    .status-badge,
    .role-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 11px;
        border-radius: 999px;
        border: 1px solid transparent;
        font-size: 0.86rem;
        line-height: 1;
        white-space: nowrap;
    }

    .status-neutral {
        background: rgba(102,112,100,0.12);
        color: var(--muted);
        border-color: rgba(102,112,100,0.16);
    }

    .status-ok {
        background: rgba(47,111,79,0.12);
        color: var(--ok);
        border-color: rgba(47,111,79,0.18);
    }

    .status-warn {
        background: rgba(148,100,25,0.12);
        color: var(--warn);
        border-color: rgba(148,100,25,0.18);
    }

    .status-danger {
        background: rgba(139,48,40,0.12);
        color: var(--danger);
        border-color: rgba(139,48,40,0.18);
    }

    .action-link {
        color: var(--accent-strong);
        text-decoration: none;
        font-weight: 700;
    }

    .action-link:hover {
        text-decoration: underline;
    }

    .data-grid {
        width: 100%;
        border-collapse: collapse;
    }

    .data-grid th,
    .data-grid td {
        padding: 13px 10px;
        border-bottom: 1px solid rgba(213,195,167,0.58);
        text-align: left;
        vertical-align: top;
    }

    .data-grid thead th {
        color: var(--muted);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
    }

    .btn-primary,
    .btn-secondary,
    .btn-danger {
        border: 0;
        border-radius: 999px;
        padding: 12px 16px;
        cursor: pointer;
        font-weight: 700;
        transition: 140ms ease;
    }

    .btn-primary {
        background: linear-gradient(135deg, var(--accent), var(--accent-strong));
        color: #fff8ef;
        box-shadow: var(--shadow-soft);
    }

    .btn-secondary {
        background: rgba(255,255,255,0.62);
        color: var(--text);
        border: 1px solid rgba(189, 168, 139, 0.7);
    }

    .btn-danger {
        background: linear-gradient(135deg, #8b3028, #6a1f1a);
        color: #fff8ef;
        box-shadow: var(--shadow-soft);
    }

    .btn-primary:hover,
    .btn-danger:hover,
    .btn-secondary:hover {
        transform: translateY(-1px);
    }

    .field-label {
        color: var(--muted);
        font-size: 0.9rem;
    }

    .field-input,
    .field-select,
    .field-textarea {
        width: 100%;
        border: 1px solid rgba(189, 168, 139, 0.9);
        border-radius: 16px;
        padding: 12px 14px;
        background: rgba(255,255,255,0.74);
        color: var(--text);
        box-sizing: border-box;
    }

    .field-textarea {
        resize: vertical;
        min-height: 120px;
    }

    .split-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
    }

    .stack-list {
        display: grid;
        gap: 12px;
    }

    .meta-text {
        color: var(--muted);
        font-size: 0.92rem;
    }

    .risk-banner {
        padding: 16px 18px;
        border-radius: 20px;
        border: 1px solid rgba(139,48,40,0.2);
        background: linear-gradient(135deg, rgba(255,236,231,0.94), rgba(255,246,244,0.98));
        color: var(--danger);
        box-shadow: var(--shadow-soft);
    }

    @@media (max-width: 900px) {
        .shell {
            grid-template-columns: 1fr;
        }

        .sidebar {
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }

        .content {
            padding: 20px;
        }

        .page-header,
        .split-grid {
            grid-template-columns: 1fr;
            display: grid;
            align-items: start;
        }
    }
</style>

@code {
    private void GoLogin() => Navigation.NavigateTo("/login");
}
