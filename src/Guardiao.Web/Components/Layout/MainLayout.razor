@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="shell">
    <aside class="sidebar">
        <div class="brand">
            <span class="brand-mark">G</span>
            <div>
                <div class="brand-name">Guardiao Ops</div>
                <div class="brand-sub">Painel operacional</div>
            </div>
        </div>

        <nav class="nav">
            <NavLink href="/" Match="NavLinkMatch.All">Resumo</NavLink>
            <NavLink href="/incidents">Incidentes</NavLink>
            <NavLink href="/cases">Casos</NavLink>
            <NavLink href="/cameras">Cameras</NavLink>
            <NavLink href="/audit">Auditoria</NavLink>
        </nav>

        <AuthorizeView>
            <Authorized Context="authState">
                <div class="session">
                    <div class="session-user">@authState.User.Identity?.Name</div>
                    <div class="session-role">@authState.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</div>
                    <form method="post" action="/operations/logout">
                        <button class="ghost" type="submit">Encerrar sessao</button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="session">
                    <button class="ghost" @onclick="GoLogin">Entrar</button>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </aside>

    <main class="content">
        @Body
    </main>
</div>

<style>
    :root {
        --bg: #f3efe7;
        --panel: #fffaf2;
        --line: #d8cbb6;
        --text: #1f2a20;
        --muted: #6e7569;
        --accent: #a4512b;
        --accent-soft: #e7c2a4;
        --ok: #2c6a4a;
        --warn: #8a5d13;
    }

    body {
        margin: 0;
        font-family: Georgia, "Iowan Old Style", serif;
        background:
            radial-gradient(circle at top left, rgba(164,81,43,0.18), transparent 32%),
            linear-gradient(180deg, #f7f2e8, #efe7d8);
        color: var(--text);
    }

    .shell {
        min-height: 100vh;
        display: grid;
        grid-template-columns: 280px 1fr;
    }

    .sidebar {
        border-right: 1px solid var(--line);
        padding: 24px 20px;
        background: rgba(255,250,242,0.86);
        backdrop-filter: blur(12px);
        display: flex;
        flex-direction: column;
        gap: 28px;
    }

    .brand {
        display: flex;
        gap: 14px;
        align-items: center;
    }

    .brand-mark {
        width: 42px;
        height: 42px;
        border-radius: 12px;
        display: grid;
        place-items: center;
        background: var(--accent);
        color: #fff8ef;
        font-weight: 700;
    }

    .brand-name {
        font-size: 1.2rem;
        font-weight: 700;
    }

    .brand-sub, .session-role {
        color: var(--muted);
        font-size: 0.9rem;
    }

    .nav {
        display: grid;
        gap: 8px;
    }

    .nav a {
        color: var(--text);
        text-decoration: none;
        padding: 10px 12px;
        border-radius: 12px;
        border: 1px solid transparent;
    }

    .nav a.active {
        background: var(--accent-soft);
        border-color: var(--line);
    }

    .content {
        padding: 28px;
    }

    .session {
        margin-top: auto;
        display: grid;
        gap: 8px;
        padding-top: 16px;
        border-top: 1px solid var(--line);
    }

    .session-user {
        font-weight: 700;
    }

    .ghost {
        border: 1px solid var(--line);
        background: transparent;
        padding: 10px 12px;
        border-radius: 999px;
        cursor: pointer;
    }

    .panel-empty {
        padding: 24px;
        border: 1px dashed var(--line);
        border-radius: 20px;
        background: rgba(255,255,255,0.4);
    }

    @@media (max-width: 900px) {
        .shell {
            grid-template-columns: 1fr;
        }

        .sidebar {
            border-right: 0;
            border-bottom: 1px solid var(--line);
        }
    }
</style>

@code {
    private void GoLogin() => Navigation.NavigateTo("/login");
}
