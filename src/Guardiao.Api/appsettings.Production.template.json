{
  "ConnectionStrings": {
    "DefaultConnection": "Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "VictimRegistry": {
    "BaseUrl": "${VICTIM_REGISTRY_BASE_URL}",
    "TokenUrl": "${VICTIM_REGISTRY_TOKEN_URL}",
    "ClientId": "${VICTIM_REGISTRY_CLIENT_ID}",
    "ClientSecret": "${VICTIM_REGISTRY_CLIENT_SECRET}",
    "Scope": "${VICTIM_REGISTRY_SCOPE}",
    "WebhookSecret": "${VICTIM_REGISTRY_WEBHOOK_SECRET}",
    "AllowedClockSkewSeconds": 300,
    "ReconciliationIntervalSeconds": 300,
    "ReconciliationPageSize": 100,
    "InitialLookbackMinutes": 60
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "${REDIS_CONNECTION_STRING}",
    "DefaultTtlSeconds": 300
  },
  "ObjectStorage": {
    "BucketName": "${OBJECT_STORAGE_BUCKET}",
    "RootPath": "${OBJECT_STORAGE_ROOT_PATH}",
    "Enabled": true,
    "MaxObjectSizeBytes": 5242880,
    "AllowedContentTypes": [ "image/jpeg", "image/png", "image/webp", "video/mp4" ],
    "AllowedFileExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".mp4" ]
  },
  "Retention": {
    "ShortLivedDays": 1,
    "CaseBoundDays": 30,
    "AuditOnlyDays": 365
  },
  "ApiSecurity": {
    "EnableDebugHeaderAuthentication": false,
    "EnableSwaggerUi": false,
    "MaxApiRequestBodyBytes": 65536,
    "MaxWebhookRequestBodyBytes": 16384,
    "ApiWriteRateLimitPermitLimit": 60,
    "ApiWriteRateLimitWindowSeconds": 60,
    "WebhookRateLimitPermitLimit": 30,
    "WebhookRateLimitWindowSeconds": 60
  }
}
