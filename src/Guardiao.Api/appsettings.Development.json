{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=guardiao_db;Username=guardiao_user;Password=your_password_here"
  },
  "VictimRegistry": {
    "BaseUrl": "https://victim-registry.example.com",
    "TokenUrl": "https://victim-registry.example.com/oauth/token",
    "ClientId": "guardiao-api",
    "ClientSecret": "change-me",
    "Scope": "cases.read media.read",
    "WebhookSecret": "change-me-too",
    "AllowedClockSkewSeconds": 300,
    "ReconciliationIntervalSeconds": 300,
    "ReconciliationPageSize": 100,
    "InitialLookbackMinutes": 60
  },
  "Redis": {
    "Enabled": false,
    "ConnectionString": "localhost:6379",
    "DefaultTtlSeconds": 300
  },
  "ObjectStorage": {
    "BucketName": "guardiao-evidence",
    "RootPath": "/tmp/guardiao-object-storage",
    "Enabled": true
  },
  "Retention": {
    "ShortLivedDays": 1,
    "CaseBoundDays": 30,
    "AuditOnlyDays": 365
  },
  "ApiSecurity": {
    "EnableDebugHeaderAuthentication": true,
    "EnableSwaggerUi": true,
    "MaxApiRequestBodyBytes": 65536,
    "MaxWebhookRequestBodyBytes": 16384,
    "ApiWriteRateLimitPermitLimit": 60,
    "ApiWriteRateLimitWindowSeconds": 60,
    "WebhookRateLimitPermitLimit": 30,
    "WebhookRateLimitWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
